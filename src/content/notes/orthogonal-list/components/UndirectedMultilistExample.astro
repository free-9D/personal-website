          <text x="128" y="42" text-anchor="middle" fill="#176b54" font-size="9">ilink</text><text x="128" y="76" text-anchor="middle" fill="#176b54" font-size="11" font-weight="700">∅</text>
          <text x="176" y="42" text-anchor="middle" fill="#176b54" font-size="9">jlink</text><text x="176" y="76" text-anchor="middle" fill="#176b54" font-size="11" font-weight="700">E23</text>
          <text x="226" y="42" text-anchor="middle" fill="#64736c" font-size="9">weight</text><text x="226" y="76" text-anchor="middle" fill="#17211e" font-size="14" font-weight="700">8</text>
          <text x="130" y="145" text-anchor="middle" fill="#176b54" font-size="12" font-weight="700">边结点 E12 · &#123;1,2&#125;</text>
        </g>
        <g transform="translate(390 645)">
