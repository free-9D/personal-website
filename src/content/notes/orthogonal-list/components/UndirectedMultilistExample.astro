<figure class="my-8" aria-labelledby="undirected-example-caption">
  <div class="overflow-x-auto rounded-2xl border border-[var(--line)] bg-white p-4 sm:p-6">
    <svg class="mx-auto h-auto min-w-[1200px] max-w-full" viewBox="0 0 1200 900" role="img" aria-labelledby="undirected-example-title undirected-example-description" xmlns="http://www.w3.org/2000/svg">
      <title id="undirected-example-title">邻接多重表结构体结点组成的无向图</title>
      <desc id="undirected-example-description">四个顶点结点卡片和四个完整边结点卡片组成环形无向图。每条边对应唯一的边结点，线段连接边的端点顶点和共享边记录。</desc>
      <text x="34" y="34" fill="#17211e" font-size="20" font-weight="700">邻接多重表：结构体结点组成的无向图</text>
      <text x="34" y="60" fill="#64736c" font-size="13">顶点卡片展示 data / firstedge；边卡片展示 ivex / jvex / ilink / jlink / weight</text>

      <!-- Each undirected edge record is shared by both endpoint vertices. Lines have no arrows. -->
      <g fill="none" stroke="#176b54" stroke-width="3" stroke-linecap="round">
        <path d="M250 165H390"/><path d="M650 165H950"/>
        <path d="M1060 235V350"/><path d="M1060 520V645"/>
        <path d="M950 715H650"/><path d="M390 715H250"/>
        <path d="M140 235V350"/><path d="M140 520V645"/>
      </g>

      <!-- MLVexNode cards use the same two-field structure layout as AdjacencyMultilistStructure.astro. -->
      <g>
        <g transform="translate(30 95)">
          <rect width="220" height="140" rx="12" fill="#f7f8f4" stroke="#cbd7ce" stroke-width="2"/>
          <text x="14" y="24" fill="#176b54" font-size="13" font-weight="700">顶点结点 · 0</text>
          <rect x="14" y="38" width="88" height="84" rx="8" fill="#fff" stroke="#dce3dc"/>
          <rect x="110" y="38" width="96" height="84" rx="8" fill="#e9f4ed" stroke="#9bc9ad"/>
          <text x="58" y="63" text-anchor="middle" fill="#64736c" font-size="11">data</text><text x="58" y="94" text-anchor="middle" fill="#17211e" font-size="18" font-weight="700">0</text>
          <text x="158" y="63" text-anchor="middle" fill="#176b54" font-size="11">firstedge</text><text x="158" y="94" text-anchor="middle" fill="#176b54" font-size="14" font-weight="700">E01</text>
        </g>
        <g transform="translate(950 95)">
          <rect width="220" height="140" rx="12" fill="#f7f8f4" stroke="#cbd7ce" stroke-width="2"/>
          <text x="14" y="24" fill="#176b54" font-size="13" font-weight="700">顶点结点 · 1</text>
          <rect x="14" y="38" width="88" height="84" rx="8" fill="#fff" stroke="#dce3dc"/>
          <rect x="110" y="38" width="96" height="84" rx="8" fill="#e9f4ed" stroke="#9bc9ad"/>
          <text x="58" y="63" text-anchor="middle" fill="#64736c" font-size="11">data</text><text x="58" y="94" text-anchor="middle" fill="#17211e" font-size="18" font-weight="700">1</text>
          <text x="158" y="63" text-anchor="middle" fill="#176b54" font-size="11">firstedge</text><text x="158" y="94" text-anchor="middle" fill="#176b54" font-size="14" font-weight="700">E01</text>
