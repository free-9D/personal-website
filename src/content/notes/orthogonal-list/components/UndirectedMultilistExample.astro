        <g transform="translate(10 350)">
          <rect width="260" height="160" rx="12" fill="#fff" stroke="#9bc9ad" stroke-width="2"/>
          <rect x="10" y="12" width="44" height="108" rx="7" fill="#f7f8f4"/><rect x="58" y="12" width="44" height="108" rx="7" fill="#f7f8f4"/><rect x="106" y="12" width="44" height="108" rx="7" fill="#e9f4ed"/><rect x="154" y="12" width="44" height="108" rx="7" fill="#e9f4ed"/><rect x="202" y="12" width="48" height="108" rx="7" fill="#f7f8f4"/>
          <text x="32" y="42" text-anchor="middle" fill="#64736c" font-size="9">ivex</text><text x="32" y="76" text-anchor="middle" fill="#17211e" font-size="15" font-weight="700">3</text>
          <text x="80" y="42" text-anchor="middle" fill="#64736c" font-size="9">jvex</text><text x="80" y="76" text-anchor="middle" fill="#17211e" font-size="15" font-weight="700">0</text>
          <text x="128" y="42" text-anchor="middle" fill="#176b54" font-size="9">ilink</text><text x="128" y="76" text-anchor="middle" fill="#176b54" font-size="11" font-weight="700">∅</text>
          <text x="176" y="42" text-anchor="middle" fill="#176b54" font-size="9">jlink</text><text x="176" y="76" text-anchor="middle" fill="#176b54" font-size="11" font-weight="700">∅</text>
