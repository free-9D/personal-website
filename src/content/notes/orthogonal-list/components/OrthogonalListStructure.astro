---
---

<figure class="my-8" aria-labelledby="orthogonal-structure-caption">
  <div class="overflow-x-auto rounded-2xl border border-[var(--line)] bg-white p-4 sm:p-6">
    <svg
      class="mx-auto h-auto min-w-[760px] max-w-full"
      viewBox="0 0 1000 620"
      role="img"
      aria-labelledby="orthogonal-svg-title orthogonal-svg-description"
      xmlns="http://www.w3.org/2000/svg"
    >
      <title id="orthogonal-svg-title">十字链表顶点头结点与弧结点的关系</title>
      <desc id="orthogonal-svg-description">
        顶点 A 的 firstout 和顶点 B 的 firstin 都指向同一个表示 A 到 B 的弧结点。弧结点包含 tailvex、headvex、weight、hlink 和 tlink 字段。
      </desc>
      <defs>
        <marker id="orthogonal-arrow" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto" markerUnits="strokeWidth">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#176b54" />
        </marker>
      </defs>

      <text x="40" y="42" fill="#17211e" font-size="20" font-weight="700">顶点头结点（VexNode）</text>
      <text x="40" y="70" fill="#64736c" font-size="14">firstin / firstout 是顶点结点的入口指针</text>

      <g>
        <rect x="60" y="100" width="390" height="174" rx="14" fill="#f7f8f4" stroke="#cbd7ce" stroke-width="2" />
        <text x="82" y="130" fill="#176b54" font-size="14" font-weight="700">顶点结点 A</text>
        <rect x="78" y="148" width="112" height="84" rx="8" fill="#ffffff" stroke="#dce3dc" />
        <rect x="194" y="148" width="112" height="84" rx="8" fill="#ffffff" stroke="#dce3dc" />
        <rect x="310" y="148" width="122" height="84" rx="8" fill="#e9f4ed" stroke="#9bc9ad" />
        <text x="134" y="173" text-anchor="middle" fill="#64736c" font-size="13">data</text>
        <text x="134" y="204" text-anchor="middle" fill="#17211e" font-size="19" font-weight="700">A</text>
        <text x="250" y="173" text-anchor="middle" fill="#64736c" font-size="13">firstin</text>
        <text x="250" y="204" text-anchor="middle" fill="#64736c" font-size="17">∅</text>
        <text x="371" y="173" text-anchor="middle" fill="#176b54" font-size="13">firstout</text>
        <text x="371" y="204" text-anchor="middle" fill="#176b54" font-size="17" font-weight="700">E₁</text>
      </g>

      <g>
        <rect x="550" y="100" width="390" height="174" rx="14" fill="#f7f8f4" stroke="#cbd7ce" stroke-width="2" />
        <text x="572" y="130" fill="#176b54" font-size="14" font-weight="700">顶点结点 B</text>
        <rect x="568" y="148" width="112" height="84" rx="8" fill="#ffffff" stroke="#dce3dc" />
        <rect x="684" y="148" width="122" height="84" rx="8" fill="#e9f4ed" stroke="#9bc9ad" />
        <rect x="810" y="148" width="112" height="84" rx="8" fill="#ffffff" stroke="#dce3dc" />
        <text x="624" y="173" text-anchor="middle" fill="#64736c" font-size="13">data</text>
        <text x="624" y="204" text-anchor="middle" fill="#17211e" font-size="19" font-weight="700">B</text>
        <text x="745" y="173" text-anchor="middle" fill="#176b54" font-size="13">firstin</text>
        <text x="745" y="204" text-anchor="middle" fill="#176b54" font-size="17" font-weight="700">E₁</text>
        <text x="866" y="173" text-anchor="middle" fill="#64736c" font-size="13">firstout</text>
        <text x="866" y="204" text-anchor="middle" fill="#64736c" font-size="17">∅</text>
      </g>

      <path d="M 371 232 L 371 320 L 430 386" fill="none" stroke="#176b54" stroke-width="3" marker-end="url(#orthogonal-arrow)" />
      <path d="M 745 232 L 745 320 L 680 386" fill="none" stroke="#176b54" stroke-width="3" marker-end="url(#orthogonal-arrow)" />
      <rect x="380" y="303" width="115" height="28" rx="14" fill="#ffffff" />
      <text x="437" y="322" text-anchor="middle" fill="#176b54" font-size="13" font-weight="600">A 的出弧链</text>
      <rect x="624" y="303" width="115" height="28" rx="14" fill="#ffffff" />
      <text x="681" y="322" text-anchor="middle" fill="#176b54" font-size="13" font-weight="600">B 的入弧链</text>

      <text x="40" y="374" fill="#17211e" font-size="20" font-weight="700">弧结点（ArcBox）</text>
      <text x="40" y="402" fill="#64736c" font-size="14">同一个弧结点同时挂在起点的出弧链和终点的入弧链中</text>
      <g>
        <rect x="210" y="420" width="580" height="132" rx="14" fill="#ffffff" stroke="#9bc9ad" stroke-width="2" />
        <rect x="222" y="432" width="104" height="108" rx="8" fill="#f7f8f4" />
        <rect x="334" y="432" width="104" height="108" rx="8" fill="#f7f8f4" />
        <rect x="446" y="432" width="104" height="108" rx="8" fill="#e9f4ed" />
        <rect x="558" y="432" width="104" height="108" rx="8" fill="#f7f8f4" />
        <rect x="670" y="432" width="108" height="108" rx="8" fill="#e9f4ed" />
        <text x="274" y="460" text-anchor="middle" fill="#64736c" font-size="13">tailvex</text>
        <text x="274" y="493" text-anchor="middle" fill="#17211e" font-size="19" font-weight="700">0 · A</text>
        <text x="386" y="460" text-anchor="middle" fill="#64736c" font-size="13">headvex</text>
        <text x="386" y="493" text-anchor="middle" fill="#17211e" font-size="19" font-weight="700">1 · B</text>
        <text x="498" y="460" text-anchor="middle" fill="#176b54" font-size="13">hlink</text>
        <text x="498" y="493" text-anchor="middle" fill="#176b54" font-size="17" font-weight="700">∅</text>
        <text x="610" y="460" text-anchor="middle" fill="#176b54" font-size="13">tlink</text>
        <text x="610" y="493" text-anchor="middle" fill="#176b54" font-size="17" font-weight="700">∅</text>
        <text x="724" y="460" text-anchor="middle" fill="#64736c" font-size="13">weight</text>
        <text x="724" y="493" text-anchor="middle" fill="#17211e" font-size="17" font-weight="700">边权 w</text>
        <text x="500" y="578" text-anchor="middle" fill="#64736c" font-size="13">弧 E₁：A → B　（tailvex 是弧尾，headvex 是弧头）</text>
      </g>
    </svg>
  </div>
  <figcaption id="orthogonal-structure-caption" class="mt-3 text-sm leading-6 text-[var(--muted)]">
    同一条弧 E₁ 同时由 A.firstout 和 B.firstin 找到；hlink、tlink 在本例中没有后继弧，因此指向空。
  </figcaption>
</figure>
