---
import { getCollection, render } from 'astro:content';
import ArticleReadingLayout from '../../layouts/ArticleReadingLayout.astro';

export async function getStaticPaths() {
  const thoughts = await getCollection('thoughts', ({ data }) => !data.draft);
  return thoughts.map((thought) => ({ params: { slug: thought.id }, props: { thought } }));
}

const { thought } = Astro.props;
const { Content, headings } = await render(thought);
const allThoughts = await getCollection('thoughts');
const relatedCollectionsNeeded = new Set(thought.data.related.map(({ collection }) => collection));
const [allNotes, allProjects] = await Promise.all([
  relatedCollectionsNeeded.has('notes') ? getCollection('notes') : Promise.resolve([]),
  thought.data.project || relatedCollectionsNeeded.has('projects') ? getCollection('projects') : Promise.resolve([]),
]);
const publicThoughts = allThoughts.filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const currentIndex = publicThoughts.findIndex((entry) => entry.id === thought.id);
const relatedCollections = { notes: allNotes, thoughts: allThoughts, projects: allProjects };
const related = thought.data.related.flatMap(({ collection, id }) => {
  const entry = relatedCollections[collection].find((item) => item.id === id && !item.data.draft);
  return entry ? [{ collection, id: entry.id, title: entry.data.title, description: entry.data.description }] : [];
});
const project = thought.data.project ? allProjects.find((item) => item.id === thought.data.project && !item.data.draft) : undefined;
const base = import.meta.env.BASE_URL;
const pathFor = (collection: string, id: string) => `${base}${collection}/${id}/`;
const previous = currentIndex > 0 ? publicThoughts[currentIndex - 1] : undefined;
const next = currentIndex >= 0 && currentIndex < publicThoughts.length - 1 ? publicThoughts[currentIndex + 1] : undefined;
---

<ArticleReadingLayout entry={thought} collection="thoughts" collectionLabel="思考" listLabel="思考" Content={Content} headings={headings} related={related} project={project ? { id: project.id, title: project.data.title } : undefined} previous={previous ? { id: previous.id, title: previous.data.title, href: pathFor('thoughts', previous.id) } : undefined} next={next ? { id: next.id, title: next.data.title, href: pathFor('thoughts', next.id) } : undefined} />
