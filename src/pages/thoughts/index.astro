---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/content/ContentCard.astro';
import ContentEmptyState from '../../components/content/ContentEmptyState.astro';

const thoughts = (await getCollection('thoughts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="思考" description="记录过程中的观察、想法与思考。">
  <header class="max-w-2xl">
    <p class="text-sm font-medium tracking-[0.18em] text-[var(--accent)]">THOUGHTS · 思考</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">过程中的观察</h1>
    <p class="mt-5 text-lg leading-8 text-[var(--muted)]">记录尚在生长的想法、日常观察，以及值得继续追问的问题。</p>
  </header>

  {thoughts.length > 0 ? (
    <ul class="mt-12 grid list-none gap-5 p-0 sm:grid-cols-2">
      {thoughts.map((thought) => (
        <li>
          <ContentCard
            title={thought.data.title}
            description={thought.data.description}
            href={`${base}thoughts/${thought.id}/`}
            pubDate={thought.data.pubDate}
            tags={thought.data.tags}
            eyebrow={thought.data.kind}
          />
        </li>
      ))}
    </ul>
  ) : (
    <ContentEmptyState title="思考正在积累中" description="这里还没有公开的思考记录。新的观察整理完成后，会在这里与您分享。" icon="◌" />
  )}
</BaseLayout>
