---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TaxonomyTermList from '../../components/taxonomy/TaxonomyTermList.astro';
import { getPublicContent, taxonomySlug } from '../../utils/public-content';

const content = await getPublicContent();
const counts = new Map<string, number>();
for (const item of content) for (const tag of new Set(item.tags)) counts.set(tag, (counts.get(tag) ?? 0) + 1);
const terms = [...counts].sort(([a], [b]) => a.localeCompare(b, 'zh-CN')).map(([label, count]) => ({ label, count, href: `${import.meta.env.BASE_URL}tags/${taxonomySlug(label)}/` }));
---

<BaseLayout title="标签" description="按主题浏览公开的笔记、思考和项目。">
  <header class="max-w-2xl">
    <p class="text-sm font-medium tracking-[0.18em] text-[var(--accent)]">TAGS · 标签</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">按主题浏览</h1>
    <p class="mt-5 text-lg leading-8 text-[var(--muted)]">从共同主题出发，找到相关的笔记、思考与项目。</p>
  </header>
  {terms.length ? <TaxonomyTermList terms={terms} ariaLabel="所有标签" /> : <p class="mt-8 text-[var(--muted)]">暂时还没有公开内容标签。</p>}
</BaseLayout>
