---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import UpdatesCard from '../../components/updates/UpdatesCard.astro';
import ContentEmptyState from '../../components/content/ContentEmptyState.astro';

const updates = (await getCollection('updates', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="更新记录" description="个人网站与项目的公开更新记录。">
  <header class="max-w-2xl">
    <p class="text-sm font-medium tracking-[0.18em] text-[var(--accent)]">UPDATES · 更新记录</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">最近更新</h1>
    <p class="mt-5 text-lg leading-8 text-[var(--muted)]">记录网站与项目逐步发生的变化，按发布日期由新到旧排列。</p>
  </header>

  {updates.length > 0 ? (
    <ol class="mt-12 grid list-none gap-5 p-0 sm:grid-cols-2">
      {updates.map((entry) => (
        <li><UpdatesCard entry={entry} href={`${base}updates/${entry.id}/`} /></li>
      ))}
    </ol>
  ) : (
    <div class="mt-12">
      <ContentEmptyState title="暂时还没有更新记录" description="新的公开更新发布后，会按时间顺序显示在这里。" icon="↻" />
    </div>
  )}
</BaseLayout>
