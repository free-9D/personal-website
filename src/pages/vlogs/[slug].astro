---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BilibiliPlayer from '../../components/vlogs/BilibiliPlayer.astro';

export async function getStaticPaths() {
  const vlogs = await getCollection('vlogs', ({ data }) => !data.draft);
  return vlogs.map((vlog) => ({ params: { slug: vlog.id }, props: { vlog } }));
}

const { vlog } = Astro.props;
const { Content } = await render(vlog);
const base = import.meta.env.BASE_URL;
const date = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(vlog.data.pubDate);
---

<BaseLayout title={vlog.data.title} description={vlog.data.description}>
  <article class="mx-auto max-w-3xl">
    <a class="text-sm text-[var(--muted)] hover:text-[var(--ink)]" href={`${base}vlogs/`}>← 返回 Vlog</a>
    <header class="mt-8 border-b border-[var(--line)] pb-8">
      <p class="text-sm font-medium tracking-[0.16em] text-[var(--accent)]">哔哩哔哩 · VLOG</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">{vlog.data.title}</h1>
      <p class="mt-4 text-lg leading-8 text-[var(--muted)]">{vlog.data.description}</p>
      <time class="mt-5 block text-sm text-[var(--muted)]" datetime={vlog.data.pubDate.toISOString()}>{date}</time>
      {vlog.data.tags.length > 0 && (
        <ul class="mt-4 flex list-none flex-wrap gap-2 p-0">
          {vlog.data.tags.map((tag) => <li class="rounded-full bg-[var(--surface)] px-3 py-1 text-xs text-[var(--muted)]">{tag}</li>)}
        </ul>
      )}
    </header>

    <section class="mt-8" aria-label="视频播放器">
      <BilibiliPlayer bvid={vlog.data.bvid} page={vlog.data.page} title={vlog.data.title} />
      <p class="mt-3 text-sm text-[var(--muted)]">
        若播放器无法加载，<a href={`https://www.bilibili.com/video/${encodeURIComponent(vlog.data.bvid)}${vlog.data.page ? `?p=${vlog.data.page}` : ''}`} target="_blank" rel="noopener noreferrer">前往哔哩哔哩观看</a>。
      </p>
    </section>

    <div class="prose prose-neutral mt-10 max-w-none leading-8">
      <Content />
    </div>
  </article>
</BaseLayout>
