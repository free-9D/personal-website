---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/content/ContentCard.astro';
import ContentEmptyState from '../../components/content/ContentEmptyState.astro';

const vlogs = (await getCollection('vlogs', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Vlog" description="视频记录与对应的文字整理。">
  <header class="max-w-2xl">
    <p class="text-sm font-medium tracking-[0.18em] text-[var(--accent)]">VLOG · 视频记录</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">Vlog</h1>
    <p class="mt-5 text-lg leading-8 text-[var(--muted)]">视频与文字记录放在一起，方便回看。</p>
  </header>

  {vlogs.length ? (
    <ul class="mt-12 grid list-none gap-5 p-0 sm:grid-cols-2">
      {vlogs.map((vlog) => (
        <li>
          <ContentCard title={vlog.data.title} description={vlog.data.description} href={`${base}vlogs/${vlog.id}/`} pubDate={vlog.data.pubDate} tags={vlog.data.tags} eyebrow="哔哩哔哩" />
        </li>
      ))}
    </ul>
  ) : (
    <div class="mt-12">
      <ContentEmptyState title="还没有公开的 Vlog" description="发布第一条 Vlog 后，它会出现在这里。" icon="▶" />
    </div>
  )}
</BaseLayout>
