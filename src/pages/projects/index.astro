---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/content/ContentCard.astro';
import ContentEmptyState from '../../components/content/ContentEmptyState.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const dateLabel = (date: Date) => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long' }).format(date);
const projectPath = (id: string) => `${import.meta.env.BASE_URL}projects/${id}/`;
---

<BaseLayout title="项目" description="正在进行与已经完成的项目记录。">
  <section aria-labelledby="projects-title">
    <p class="mb-3 text-sm font-medium tracking-wide text-[var(--accent)]">PROJECTS</p>
    <h1 id="projects-title" class="text-4xl font-semibold tracking-tight sm:text-5xl">项目</h1>
    <p class="mt-5 max-w-2xl leading-7 text-[var(--muted)]">记录正在做的事、做过的尝试，以及过程中积累的经验。</p>

    {projects.length > 0 ? (
      <ul class="mt-10 grid list-none gap-5 p-0 sm:grid-cols-2">
        {projects.map((project) => (
          <li>
            <ContentCard
              title={project.data.title}
              description={project.data.description}
              href={projectPath(project.id)}
              pubDate={project.data.pubDate}
              tags={project.data.tags}
              tagLabel="项目标签"
              status={project.data.status}
              dateRange={`${dateLabel(project.data.startDate)} — ${project.data.endDate ? dateLabel(project.data.endDate) : '至今'}`}
              dateTime={project.data.startDate}
              links={project.data.links}
            />
          </li>
        ))}
      </ul>
    ) : (
      <ContentEmptyState title="这里还没有项目" description="项目开始后，会在这里记录它的进展与成果。" icon="◇" />
    )}
  </section>
</BaseLayout>
