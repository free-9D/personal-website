---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf());
const dateLabel = (date: Date) => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long' }).format(date);
const projectPath = (id: string) => `${import.meta.env.BASE_URL}projects/${id}/`;
const statusStyles: Record<string, string> = {
  进行中: 'bg-emerald-100 text-emerald-800',
  已完成: 'bg-slate-100 text-slate-700',
  暂停: 'bg-amber-100 text-amber-800',
};
---

<BaseLayout title="项目" description="正在进行与已经完成的项目记录。">
  <section aria-labelledby="projects-title">
    <p class="mb-3 text-sm font-medium tracking-wide text-[var(--accent)]">PROJECTS</p>
    <h1 id="projects-title" class="text-4xl font-semibold tracking-tight sm:text-5xl">项目</h1>
    <p class="mt-5 max-w-2xl leading-7 text-[var(--muted)]">记录正在做的事、做过的尝试，以及过程中积累的经验。</p>

    {projects.length > 0 ? (
      <ul class="mt-10 grid list-none gap-5 p-0 sm:grid-cols-2">
        {projects.map((project) => (
          <li>
            <article class="flex h-full flex-col rounded-2xl border border-[var(--line)] bg-white/60 p-6 transition hover:border-[var(--accent)]">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <span class={`rounded-full px-3 py-1 text-xs font-medium ${statusStyles[project.data.status] ?? 'bg-slate-100 text-slate-700'}`}>
                  {project.data.status}
                </span>
                <time class="text-sm text-[var(--muted)]" datetime={project.data.startDate.toISOString()}>
                  {dateLabel(project.data.startDate)}{project.data.endDate ? ` — ${dateLabel(project.data.endDate)}` : ''}
                </time>
              </div>
              <h2 class="mt-5 text-xl font-semibold tracking-tight">
                <a class="rounded-sm no-underline hover:text-[var(--accent)]" href={projectPath(project.id)}>{project.data.title}</a>
              </h2>
              <p class="mt-3 flex-1 leading-7 text-[var(--muted)]">{project.data.description}</p>
              {project.data.tags.length > 0 && (
                <ul aria-label="项目标签" class="mt-5 flex list-none flex-wrap gap-2 p-0">
                  {project.data.tags.map((tag) => <li class="rounded-md bg-[var(--paper)] px-2.5 py-1 text-xs text-[var(--muted)]">{tag}</li>)}
                </ul>
              )}
            </article>
          </li>
        ))}
      </ul>
    ) : (
      <div class="mt-10 rounded-2xl border border-dashed border-[var(--line)] px-6 py-12 text-center">
        <h2 class="text-lg font-medium">这里还没有项目</h2>
        <p class="mt-2 text-sm leading-6 text-[var(--muted)]">项目开始后，会在这里记录它的进展与成果。</p>
      </div>
    )}
  </section>
</BaseLayout>
