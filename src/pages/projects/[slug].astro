---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
const links = data.links ?? [];
const [notes, thoughts, projects] = await Promise.all([
  getCollection('notes', ({ data }) => !data.draft),
  getCollection('thoughts', ({ data }) => !data.draft),
  getCollection('projects', ({ data }) => !data.draft),
]);
const noteById = new Map(notes.map((entry) => [entry.id, entry]));
const thoughtById = new Map(thoughts.map((entry) => [entry.id, entry]));
const projectById = new Map(projects.map((entry) => [entry.id, entry]));
type RelatedItem = {
  id: string;
  collection: 'notes' | 'thoughts' | 'projects';
  title: string;
  description: string;
  pubDate: Date;
};
const relatedItems: RelatedItem[] = [];
const relatedKeys = new Set<string>();
const addRelated = (collection: RelatedItem['collection'], entry: { id: string; data: { title: string; description: string; pubDate: Date } }) => {
  const key = `${collection}:${entry.id}`;
  if (relatedKeys.has(key)) return;
  relatedKeys.add(key);
  relatedItems.push({ collection, id: entry.id, ...entry.data });
};

for (const relation of data.related) {
  if (relation.collection === 'notes') {
    const entry = noteById.get(relation.id);
    if (entry) addRelated('notes', entry);
  } else if (relation.collection === 'thoughts') {
    const entry = thoughtById.get(relation.id);
    if (entry) addRelated('thoughts', entry);
  } else {
    const entry = projectById.get(relation.id);
    if (entry && entry.id !== project.id) addRelated('projects', entry);
  }
}

for (const entry of notes) {
  if (entry.data.project === project.id) addRelated('notes', entry);
}
for (const entry of thoughts) {
  if (entry.data.project === project.id) addRelated('thoughts', entry);
}
relatedItems.sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());
const dateLabel = (date: Date) => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(date);
const projectIndex = `${import.meta.env.BASE_URL}projects/`;
const collectionLabels = { notes: '笔记', thoughts: '思考', projects: '相关项目' };
const relatedHref = (item: RelatedItem) => `${import.meta.env.BASE_URL}${item.collection}/${item.id}/`;
const safeExternalUrl = (raw: string) => {
  try {
    const url = new URL(raw);
    return url.protocol === 'https:' || url.protocol === 'http:' ? url.href : undefined;
  } catch {
    return undefined;
  }
};
---

<BaseLayout title={data.title} description={data.description}>
  <article>
    <a class="inline-flex rounded-sm text-sm text-[var(--muted)] no-underline hover:text-[var(--accent)]" href={projectIndex}>← 返回项目列表</a>
    <header class="mt-8 border-b border-[var(--line)] pb-8">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-[var(--muted)]">
        <span class="rounded-full bg-[var(--paper)] px-3 py-1 font-medium text-[var(--ink)]">{data.status}</span>
        <span>{dateLabel(data.startDate)}{data.endDate ? ` — ${dateLabel(data.endDate)}` : ' — 至今'}</span>
      </div>
      <h1 class="mt-5 text-4xl font-semibold tracking-tight sm:text-5xl">{data.title}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-[var(--muted)]">{data.description}</p>
      {data.tags.length > 0 && (
        <ul aria-label="项目标签" class="mt-5 flex list-none flex-wrap gap-2 p-0">
          {data.tags.map((tag) => <li class="rounded-md bg-[var(--paper)] px-2.5 py-1 text-xs text-[var(--muted)]">{tag}</li>)}
        </ul>
      )}
      {links.length > 0 && (
        <ul aria-label="项目相关链接" class="mt-6 flex list-none flex-wrap gap-3 p-0">
          {links.map((link) => {
            const href = safeExternalUrl(link.url);
            return href ? <li><a class="inline-flex rounded-lg border border-[var(--line)] px-4 py-2 text-sm font-medium no-underline hover:border-[var(--accent)] hover:text-[var(--accent)]" href={href} target="_blank" rel="noopener noreferrer">{link.label}<span class="sr-only">（在新标签页打开）</span></a></li> : null;
          })}
        </ul>
      )}
    </header>
    <div class="prose prose-slate mt-10 max-w-none leading-7 prose-headings:tracking-tight prose-a:text-[var(--accent)] prose-img:rounded-xl">
      <Content />
    </div>
    {relatedItems.length > 0 && (
      <section class="mt-14 border-t border-[var(--line)] pt-8" aria-labelledby="related-content-title">
        <h2 id="related-content-title" class="text-2xl font-semibold tracking-tight">相关内容</h2>
        <ul class="mt-5 grid list-none gap-4 p-0 sm:grid-cols-2">
          {relatedItems.map((item) => (
            <li>
              <article class="h-full rounded-xl border border-[var(--line)] bg-white/50 p-5">
                <p class="text-xs font-medium text-[var(--accent)]">{collectionLabels[item.collection]}</p>
                <h3 class="mt-2 text-lg font-semibold"><a class="no-underline hover:text-[var(--accent)]" href={relatedHref(item)}>{item.title}</a></h3>
                <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{item.description}</p>
                <time class="mt-3 block text-xs text-[var(--muted)]" datetime={item.pubDate.toISOString()}>{dateLabel(item.pubDate)}</time>
              </article>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
