---
import { getCollection, render } from 'astro:content';
import ArticleReadingLayout from '../../layouts/ArticleReadingLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const allNotes = await getCollection('notes');
const relatedCollectionsNeeded = new Set(note.data.related.map(({ collection }) => collection));
const [allThoughts, allProjects] = await Promise.all([
  relatedCollectionsNeeded.has('thoughts') ? getCollection('thoughts') : Promise.resolve([]),
  note.data.project || relatedCollectionsNeeded.has('projects') ? getCollection('projects') : Promise.resolve([]),
]);
const publicNotes = allNotes.filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const currentIndex = publicNotes.findIndex((entry) => entry.id === note.id);
const relatedCollections = { notes: allNotes, thoughts: allThoughts, projects: allProjects };
const related = note.data.related.flatMap(({ collection, id }) => {
  const entry = relatedCollections[collection].find((item) => item.id === id && !item.data.draft);
  return entry ? [{ collection, id: entry.id, title: entry.data.title, description: entry.data.description }] : [];
});
const project = note.data.project ? allProjects.find((item) => item.id === note.data.project && !item.data.draft) : undefined;
const base = import.meta.env.BASE_URL;
const pathFor = (collection: string, id: string) => `${base}${collection}/${id}/`;
const previous = currentIndex > 0 ? publicNotes[currentIndex - 1] : undefined;
const next = currentIndex >= 0 && currentIndex < publicNotes.length - 1 ? publicNotes[currentIndex + 1] : undefined;
---

<ArticleReadingLayout entry={note} collection="notes" collectionLabel="笔记" listLabel="笔记" Content={Content} headings={headings} related={related} project={project ? { id: project.id, title: project.data.title } : undefined} previous={previous ? { id: previous.id, title: previous.data.title, href: pathFor('notes', previous.id) } : undefined} next={next ? { id: next.id, title: next.data.title, href: pathFor('notes', next.id) } : undefined} />
