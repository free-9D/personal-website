---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/content/ContentCard.astro';
import ContentEmptyState from '../../components/content/ContentEmptyState.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="笔记" description="整理值得复用的知识与学习笔记。">
  <header class="max-w-2xl">
    <p class="text-sm font-medium tracking-[0.18em] text-[var(--accent)]">NOTES · 笔记</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">学习与整理</h1>
    <p class="mt-5 text-lg leading-8 text-[var(--muted)]">把值得复用的知识收集起来，慢慢搭建自己的知识库。</p>
  </header>

  {notes.length > 0 ? (
    <ul class="mt-12 grid list-none gap-5 p-0 sm:grid-cols-2">
      {notes.map((note) => (
        <li>
          <ContentCard
            title={note.data.title}
            description={note.data.description}
            href={`${base}notes/${note.id}/`}
            pubDate={note.data.pubDate}
            tags={note.data.tags}
            eyebrow={note.data.category}
          />
        </li>
      ))}
    </ul>
  ) : (
    <ContentEmptyState title="笔记正在整理中" description="这里还没有公开的笔记。整理好第一篇内容后，它就会出现在这里。" icon="✎" />
  )}
</BaseLayout>
