---
import BaseLayout from './BaseLayout.astro';

interface Heading { depth: number; slug: string; text: string }
interface LinkCard { id: string; title: string; href: string }
interface RelatedItem { collection: 'notes' | 'thoughts' | 'projects'; id: string; title: string; description: string }
interface Props {
  entry: any;
  collection: 'notes' | 'thoughts';
  collectionLabel: string;
  listLabel: string;
  Content: any;
  headings: Heading[];
  related: RelatedItem[];
  previous?: LinkCard;
  next?: LinkCard;
  project?: { id: string; title: string };
}

const { entry, collection, collectionLabel, listLabel, Content, headings, related, previous, next, project } = Astro.props;
const base = import.meta.env.BASE_URL;
const dateLabel = (date: Date) => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(date);
const readMinutes = Math.max(1, Math.ceil(((entry.body.match(/[\u4e00-\u9fff]/g) ?? []).length / 400) + ((entry.body.match(/[A-Za-z0-9]+/g) ?? []).length / 200)));
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const collectionName = (value: RelatedItem['collection']) => ({ notes: '笔记', thoughts: '思考', projects: '项目' })[value];
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="mx-auto max-w-4xl">
    <a class="text-sm text-[var(--accent)] no-underline hover:underline" href={`${base}${collection}/`}>← 返回{listLabel}列表</a>
    <header class="mt-8 border-b border-[var(--line)] pb-8">
      <p class="text-sm font-medium tracking-[0.16em] text-[var(--accent)]">{collectionLabel.toUpperCase()} · {collectionLabel}</p>
      <h1 class="mt-4 text-3xl font-semibold leading-tight tracking-tight sm:text-5xl">{entry.data.title}</h1>
      <p class="mt-5 text-lg leading-8 text-[var(--muted)]">{entry.data.description}</p>
      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-[var(--muted)]">
        <time datetime={entry.data.pubDate.toISOString()}>发布于 {dateLabel(entry.data.pubDate)}</time>
        {entry.data.updatedDate && <time datetime={entry.data.updatedDate.toISOString()}>更新于 {dateLabel(entry.data.updatedDate)}</time>}
        <span>约 {readMinutes} 分钟阅读</span>
        {entry.data.category && <span>分类：{entry.data.category}</span>}
        {entry.data.kind && <span>类型：{entry.data.kind}</span>}
        {entry.data.series && <span>系列：{entry.data.series}</span>}
        {project && <a class="text-[var(--accent)] underline" href={`${base}projects/${project.id}/`}>项目：{project.title}</a>}
      </div>
      {entry.data.tags.length > 0 && <ul class="mt-5 flex flex-wrap gap-2" aria-label="标签">
        {entry.data.tags.map((tag: string) => <li class="rounded-full border border-[var(--line)] px-3 py-1 text-xs text-[var(--muted)]">{tag}</li>)}
      </ul>}
    </header>

    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_15rem]">
      {tocHeadings.length > 0 && <aside class="order-first lg:sticky lg:top-6 lg:order-last lg:col-start-2 lg:row-start-1 lg:self-start">
        <nav class="rounded-2xl border border-[var(--line)] bg-white/60 p-5" aria-label="文章目录">
          <h2 class="text-sm font-semibold">文章目录</h2>
          <ol class="mt-3 space-y-2 text-sm leading-6 text-[var(--muted)]">
            {tocHeadings.map((heading) => <li class={heading.depth === 3 ? 'ml-4' : ''}><a class="no-underline hover:text-[var(--accent)]" href={`#${heading.slug}`}>{heading.text}</a></li>)}
          </ol>
        </nav>
      </aside>}

      <div class="content-body order-last min-w-0 leading-8 lg:order-first lg:col-start-1 lg:row-start-1 [&_h2]:mt-10 [&_h2]:scroll-mt-8 [&_h2]:text-2xl [&_h2]:font-semibold [&_h3]:mt-8 [&_h3]:scroll-mt-8 [&_h3]:text-xl [&_h3]:font-semibold [&_p]:my-5 [&_a]:text-[var(--accent)] [&_a]:underline [&_ul]:my-5 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:my-5 [&_ol]:list-decimal [&_ol]:pl-6 [&_blockquote]:my-6 [&_blockquote]:border-l-4 [&_blockquote]:border-[var(--line)] [&_blockquote]:pl-5 [&_blockquote]:text-[var(--muted)] [&_pre]:my-6 [&_pre]:overflow-x-auto [&_pre]:rounded-xl [&_pre]:bg-[#17211e] [&_pre]:p-4 [&_pre]:text-sm [&_pre]:text-white [&_code]:rounded [&_code]:bg-black/5 [&_code]:px-1 [&_img]:my-6 [&_img]:h-auto [&_img]:max-w-full">
        <Content />
      </div>
    </div>

    {related.length > 0 && <section class="mt-12 border-t border-[var(--line)] pt-8" aria-labelledby="related-title">
      <h2 id="related-title" class="text-xl font-semibold">相关文章</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {related.map((item) => <li><a class="block rounded-xl border border-[var(--line)] bg-white/60 p-4 no-underline transition hover:border-[var(--accent)]" href={`${base}${item.collection}/${item.id}/`}><span class="text-xs text-[var(--accent)]">{collectionName(item.collection)}</span><span class="mt-1 block font-medium text-[var(--ink)]">{item.title}</span><span class="mt-1 block text-sm leading-6 text-[var(--muted)]">{item.description}</span></a></li>)}
      </ul>
    </section>}

    {(previous || next) && <nav class="mt-10 grid gap-3 border-t border-[var(--line)] pt-8 sm:grid-cols-2" aria-label="上一篇和下一篇">
      {previous ? <a class="rounded-xl border border-[var(--line)] p-4 no-underline hover:border-[var(--accent)]" href={previous.href}><span class="block text-xs text-[var(--muted)]">← 上一篇</span><span class="mt-1 block font-medium">{previous.title}</span></a> : <span />}
      {next && <a class="rounded-xl border border-[var(--line)] p-4 text-right no-underline hover:border-[var(--accent)]" href={next.href}><span class="block text-xs text-[var(--muted)]">下一篇 →</span><span class="mt-1 block font-medium">{next.title}</span></a>}
    </nav>}
  </article>
</BaseLayout>
